#Fizzbuzz game - A common programming challenge that involves printing numbers from 1 to 100, but for multiples of 3, print "Fizz" instead of the number, and for multiples of 5, print "Buzz". For numbers which are multiples of both 3 and 5, print "FizzBuzz".
for i in range(1, 101):
    # Check for numbers divisible by both 3 and 5 first
    if i % 3 == 0 and i % 5 == 0:
        print("FizzBuzz")
    # Check for numbers divisible by 3
    elif i % 3 == 0:
        print("Fizz")
    # Check for numbers divisible by 5
    elif i % 5 == 0:
        print("Buzz")
    # Otherwise, print the number itself
    else:
        print(i)

